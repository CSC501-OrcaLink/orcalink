        <mxCell id="KEhqj0kS6PCCPFDu_pYE-67" parent="KEhqj0kS6PCCPFDu_pYE-66" style="text;strokeColor=none;fillColor=light-dark(transparent,#F6F4FC);align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;• Individual whale IDs (when available)&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Sighting ID and encounter details&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Shifted timestamps and coordinates (for privacy)&lt;br&gt;• Some IDs may be assigned based on group or matriline reports&lt;br&gt;• Records may include missing individual IDs&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="208" width="320" y="105" as="geometry" />
        </mxCell>
