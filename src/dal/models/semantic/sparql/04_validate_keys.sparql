PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?class ?keyProperty
WHERE {
    GRAPH <https://github.com/CSC501-OrcaLink/orcalink/graph/ontology> {
        ?class owl:hasKey ?keyList .

        ?keyList rdf:rest*/rdf:first ?keyProperty .
    }
}
ORDER BY ?class ?keyProperty